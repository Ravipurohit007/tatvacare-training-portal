# Firebase Configuration
# Create a project at https://console.firebase.google.com
# Enable Firestore Database in your project
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Server-only (no VITE_ prefix — never shipped to the browser bundle).
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
# Paste the full JSON as a single-line string. Used by api/submissions.js (firebase-admin)
# to read/write Firestore on behalf of the app, bypassing per-request Firestore rules.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Admin panel auth is Google Sign-In restricted to @tatvacare.in accounts (see src/pages/Admin.jsx).
# VITE_ADMIN_PASSWORD is obsolete and no longer read.

# SOP Document URL (Google Drive, SharePoint, etc.)
VITE_SOP_URL=https://your-sop-document-url
